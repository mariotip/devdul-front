# Copia este archivo a .env.local para desarrollo local.
# En Vercel, configura estas variables en Project Settings > Environment Variables.

# URL publica del sitio (se usa para metadatos SEO y Open Graph)
NEXT_PUBLIC_SITE_URL=https://devdul.com

# Correo donde llegan los mensajes del boton "Contactar"
NEXT_PUBLIC_CONTACT_EMAIL=contacto@devdul.com

# URL del backend (devdul-back en Cloudflare Workers). Lo usa el cotizador.
# En local: http://localhost:8787 (npm run dev en devdul-back)
NEXT_PUBLIC_API_URL=http://localhost:8787
